{
  "uid": "gpu-fleet",
  "title": "GPU fleet health",
  "tags": [
    "gpu",
    "ai"
  ],
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "thanos"
        },
        "query": {
          "query": "label_values(DCGM_FI_DEV_GPU_UTIL, cluster)",
          "refId": "cluster"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      },
      {
        "name": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "thanos"
        },
        "query": {
          "query": "label_values(DCGM_FI_DEV_GPU_UTIL{cluster=~\"$cluster\"}, Hostname)",
          "refId": "host"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPUs reporting",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(DCGM_FI_DEV_GPU_UTIL{cluster=~\"$cluster\", Hostname=~\"$host\"})",
          "legendFormat": "GPUs"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Avg GPU utilization",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(DCGM_FI_DEV_GPU_UTIL{cluster=~\"$cluster\", Hostname=~\"$host\"})",
          "legendFormat": "util"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "GPUs with XID errors",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(DCGM_FI_DEV_XID_ERRORS{cluster=~\"$cluster\", Hostname=~\"$host\"} > 0) or vector(0)",
          "legendFormat": "xid"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fleet power draw",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(DCGM_FI_DEV_POWER_USAGE{cluster=~\"$cluster\", Hostname=~\"$host\"})",
          "legendFormat": "W"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GPU utilization by host",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (Hostname) (DCGM_FI_DEV_GPU_UTIL{cluster=~\"$cluster\", Hostname=~\"$host\"})",
          "legendFormat": "{{Hostname}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GPU memory used %",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (Hostname, gpu) (DCGM_FI_DEV_FB_USED{cluster=~\"$cluster\", Hostname=~\"$host\"} / (DCGM_FI_DEV_FB_USED{cluster=~\"$cluster\", Hostname=~\"$host\"} + DCGM_FI_DEV_FB_FREE{cluster=~\"$cluster\", Hostname=~\"$host\"}) * 100)",
          "legendFormat": "{{Hostname}}/{{gpu}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU temperature",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (Hostname, gpu) (DCGM_FI_DEV_GPU_TEMP{cluster=~\"$cluster\", Hostname=~\"$host\"})",
          "legendFormat": "{{Hostname}}/{{gpu}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "SM active ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (Hostname) (DCGM_FI_PROF_SM_ACTIVE{cluster=~\"$cluster\", Hostname=~\"$host\"})",
          "legendFormat": "{{Hostname}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "ECC double-bit errors (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (Hostname, gpu) (increase(DCGM_FI_DEV_ECC_DBE_VOL_TOTAL{cluster=~\"$cluster\", Hostname=~\"$host\"}[1h]))",
          "legendFormat": "{{Hostname}}/{{gpu}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "PCIe replays (rate)",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (Hostname) (rate(DCGM_FI_DEV_PCIE_REPLAY_COUNTER{cluster=~\"$cluster\", Hostname=~\"$host\"}[5m]))",
          "legendFormat": "{{Hostname}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "expr": "{namespace=\"argocd\"} |= \"sync\" |= \"Succeeded\"",
        "enable": true,
        "iconColor": "blue"
      }
    ]
  }
}
