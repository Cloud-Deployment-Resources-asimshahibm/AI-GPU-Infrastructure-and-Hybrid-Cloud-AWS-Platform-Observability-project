{
  "uid": "obs-platform-health",
  "title": "Observability platform health",
  "tags": [
    "meta",
    "platform"
  ],
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Active series by cluster",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster) (prometheus_tsdb_head_series)",
          "legendFormat": "{{cluster}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Top 10 jobs by samples/scrape",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, max by (job) (scrape_samples_post_metric_relabeling))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Kafka consumer lag (vector-logs)",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"vector-logs\"})",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Loki bytes received by tenant",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant) (rate(loki_distributor_bytes_received_total[5m]))",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tempo spans received by tenant",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant) (rate(tempo_distributor_spans_received_total[5m]))",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "OTel spans refused / dropped",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_processor_refused_spans_total[5m]))",
          "legendFormat": "refused"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_exporter_send_failed_spans_total[5m]))",
          "legendFormat": "send failed"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Thanos compactor halted",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(thanos_compact_halted)",
          "legendFormat": "halted"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Rule evaluation failures (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 6,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(prometheus_rule_evaluation_failures_total[1h]))",
          "legendFormat": "failures"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Coverage scorecard: failing checks",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(obs_coverage_check == 0) or vector(0)",
          "legendFormat": "failing"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Alerts firing by team",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "x": 18,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (team) (ALERTS{alertstate=\"firing\", severity!=\"none\"})",
          "legendFormat": "{{team}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "expr": "{namespace=\"argocd\"} |= \"sync\" |= \"Succeeded\"",
        "enable": true,
        "iconColor": "blue"
      }
    ]
  }
}
